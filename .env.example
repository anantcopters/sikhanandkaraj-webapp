#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development
app.baseURL = 'http://sikhanandkaraj.local/'
app.indexPage = ''
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# app.baseURL = ''
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = 127.0.0.1
database.default.database = db_sikhanandkaraj_dev
database.default.username = sikhanandkaraj_dev_admin
database.default.password = 
database.default.DBDriver = Postgre
database.default.DBPrefix =
database.default.port = 5432
database.default.charset = utf8
database.default.DBCollat = utf8_general_ci

# --------------------------------------------------------------------
# SECURITY
# --------------------------------------------------------------------

encryption.key = 

security.csrfProtection = session
security.tokenRandomize = true
security.tokenName = sak_csrf_token
security.headerName = X-CSRF-TOKEN
security.cookieName = sak_csrf_cookie
security.expires = 7200
security.regenerate = true

# --------------------------------------------------------------------
# SESSION
# --------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\DatabaseHandler'
session.cookieName = sak_session
session.expiration = 7200
session.savePath = ci_sessions
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = false   

# --------------------------------------------------------------------
# AWS S3
# --------------------------------------------------------------------

aws.region =
aws.s3.bucket =
aws.s3.publicBaseUrl =
aws.accessKeyId =
aws.secretAccessKey =

# --------------------------------------------------------------------
# OTP
# --------------------------------------------------------------------
OTP_FIXED_VALUE=

sms.provider = http
sms.apiUrl = YOUR_SMS_PROVIDER_URL
sms.apiKey = YOUR_SECRET_API_KEY
sms.senderId = SIKHAK
sms.registrationTemplateId = YOUR_DLT_TEMPLATE_ID
